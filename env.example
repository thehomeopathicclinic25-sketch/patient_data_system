# Copy this file to .env for local testing (never commit the real .env to GitHub)

# From Supabase: Connect button -> Session pooler -> copy URI, replace [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.xxxx:yourpassword@xxxx.pooler.supabase.com:5432/postgres

# Fill these in once you sign up with a WhatsApp BSP
WHATSAPP_API_URL=https://api.yourprovider.com/v1/messages
WHATSAPP_API_KEY=your_api_key_here
WHATSAPP_TEMPLATE_NAME=followup_reminder

# Used inside the reminder message text
CLINIC_NAME=Your Clinic Name
